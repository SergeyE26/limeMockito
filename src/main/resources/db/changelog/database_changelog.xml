<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="00_create_schema" author="Raoul Duke">
        <sql>
            CREATE SCHEMA IF NOT EXISTS public;
        </sql>
        <rollback>
            <sql>
                DROP SCHEMA IF EXISTS public;
            </sql>
        </rollback>
    </changeSet>
    <changeSet id="01_create_table_fruits" author="Raoul Duke">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="fruits"/>
            </not>
        </preConditions>
        <createTable tableName="fruits">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_fruits"/>
            </column>
            <column name="name" type="varchar"/>
            <column name="description" type="varchar"/>
        </createTable>
        <rollback>
            <dropTable tableName="fruits"/>
        </rollback>
    </changeSet>
</databaseChangeLog>